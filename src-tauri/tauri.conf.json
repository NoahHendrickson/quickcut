{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickCut",
  "version": "1.3.2",
  "identifier": "com.quickcut.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QuickCut",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0f1012",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Noah Hendrickson",
    "shortDescription": "Fast, lossless video trimming",
    "copyright": "© 2026 Noah Hendrickson",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mov",
          "mkv",
          "m4v",
          "webm"
        ],
        "name": "Video",
        "description": "Video",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGMDk1MTgyOEE5M0M5QUQKUldTdHlaT0tnbEVKVHppeDl3TW1iU1EzaC9jR3g1Rk9MK0tCMUxFWGJPa05uSitrd3NHbCtZazcK",
      "endpoints": [
        "https://github.com/NoahHendrickson/quickcut/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
